    "<span class="hljs-attribute">nbf</span>": <span class="hljs-value"><span class="hljs-literal">null</span></span>,
    "<span class="hljs-attribute">iat</span>": <span class="hljs-value">&lt;timestamp&gt;</span>,
    "<span class="hljs-attribute">jit</span>": <span class="hljs-value">&lt;uuid&gt;</span>,
