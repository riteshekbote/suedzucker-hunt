  var ERROR_CORRECTION_BYTES = 72
  var PAYLOAD_BYTES = 44
  var CODED_BITS = (FRAME_BYTES + ERROR_CORRECTION_BYTES) * 8
  var rootId = 'ceres-screenshot-watermark'
  var NORMAL_OPACITY = 0.002
  var PHOTO_OPACITY = 0.005
  var REVEALED_OPACITY = 0.18

  function randomGenerator(seed) {
    var state = seed >>> 0
    return function () {
      state ^= state << 13
      state ^= state >>> 17
      state ^= state << 5
      return state >>> 0
    }
  }

  function layout() {
    var positions = []
    var index
    for (index = 0; index < GRID_SIZE * GRID_SIZE; index++) {
      positions.push(index)
    }
    var random = randomGenerator(0x43524553)
    for (index = positions.length - 1; index > 0; index--) {
      var otherIndex = random() % (index + 1)
      var current = positions[index]
      positions[index] = positions[otherIndex]
      positions[otherIndex] = current
    }
    var pilotRandom = randomGenerator(0x5355504f)
    var whiteningRandom = randomGenerator(0x57415445)
    var pilotBits = []
    var whiteningBits = []
    for (index = 0; index < positions.length - CODED_BITS; index++) {
      pilotBits.push(pilotRandom() & 1)
    }
    for (index = 0; index < CODED_BITS; index++) {
      whiteningBits.push(whiteningRandom() & 1)
    }
    return {
      dataPositions: positions.slice(0, CODED_BITS),
      pilotBits: pilotBits,
      pilotPositions: positions.slice(CODED_BITS),
      whiteningBits: whiteningBits,
    }

